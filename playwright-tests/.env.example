# Base URL of the frontend under test
BASE_URL=http://localhost:3000

# Base URL of the backend API. Used to wake it up before tests run, in case
# it's a free Render service that spins down after inactivity.
API_URL=http://localhost:5258

# Dedicated Playwright test account credentials.
# Create this account in each environment (local, staging, ...) ahead of time.
# Locally, copy this file to .env and fill in the values.
# In CI, these are supplied via GitHub Environment secrets instead of a .env file.
TEST_USER_EMAIL=
TEST_USER_PASSWORD=

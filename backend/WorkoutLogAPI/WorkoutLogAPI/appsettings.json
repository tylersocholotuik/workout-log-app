{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Information"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Cors": {
    "AllowedOrigins": [ "https://workoutlogapp.vercel.app" ]
  },
  "Jwt": {
    "Issuer": "WorkoutLogAPI",
    "Audience": "WorkoutLogApp",
    "SecretKey": "",
    "TokenExpirationInMinutes": 180,
    "RefreshThresholdInMinutes": 30
  },
  "Smtp": {
    "EnableSmtp": false,
    "Host": "smtp-relay.brevo.com",
    "Port": 587,
    "Username": "",
    "Password": "",
    "FromEmail": "",
    "FromName": "Workout Log"
  },
  "Brevo": {
    "BaseUrl": "https://api.brevo.com/v3/smtp/email",
    "ApiKey": ""
  },
  "Frontend": {
    "BaseUrl": "https://workoutlogapp.vercel.app"
  },
  "PasswordReset": {
    "TokenExpirationInMinutes": 15
  }

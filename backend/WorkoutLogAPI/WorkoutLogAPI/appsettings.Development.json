{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Information"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "USER_SECRETS_CONNECTION_STRING"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000" ]
  },
  "Jwt": {
    "Issuer": "WorkoutLogAPIDev",
    "Audience": "WorkoutLogAppDev",
    "SecretKey": "USER_SECRETS_JWT_SECRET_KEY",
    "TokenExpirationInMinutes": 180,
    "RefreshThresholdInMinutes": 30
  },
  "Smtp": {
    "EnableSmtp": false,
    "Host": "smtp-relay.brevo.com",
    "Port": 587,
    "Username": "USER_SECRETS_SMTP_USERNAME",
    "Password": "USER_SECRETS_SMTP_PASSWORD",
    "FromEmail": "YOUR_EMAIL_ADDRESS",
    "FromName": "Workout Log [DEV]"
  },
  "Brevo": {
    "BaseUrl": "https://api.brevo.com/v3/smtp/email",
    "ApiKey": "USER_SECRETS_BREVO_API_KEY"
  },
  "Frontend": {
    "BaseUrl": "http://localhost:3000"
  },
  "PasswordReset": {
    "TokenExpirationInMinutes": 15
  }
}

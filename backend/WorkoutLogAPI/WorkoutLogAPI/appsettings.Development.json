{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Information"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "USER_SECRETS_CONNECTION_STRING"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000" ]
  },
  "Jwt": {
    "Issuer": "WorkoutLogAPI",
    "Audience": "WorkoutLogApp",
    "SecretKey": "USER_SECRETS_JWT_SECRET_KEY",
    "TokenExpirationInMinutes": 180,
    "RefreshThresholdInMinutes": 30
  }
}
